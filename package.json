{
  "name": "rodovid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "data:convert": "node scripts/convert-data.ts",
    "data:validate": "node scripts/convert-data.ts --validate-only",
    "data:check-gedcom": "node scripts/check-gedcom.ts",
    "source:list": "node scripts/source-records.ts --list",
    "source:add": "node scripts/source-records.ts",
    "source:sync": "node scripts/sync-source-records.ts",
    "source:dedupe": "node scripts/deduplicate-source-scans.ts",
    "dev": "vite",
    "dev:react-svg": "vite --config vite.react-svg.config.ts",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "build": "npm run typecheck && vite build",
    "build:react-svg": "npm run typecheck && vite build --config vite.react-svg.config.ts",
    "preview": "vite preview",
    "preview:react-svg": "vite preview --config vite.react-svg.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:react-svg": "playwright test --config playwright.react-svg.config.ts"
  },
  "dependencies": {
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "leaflet": "1.9.4",
    "motion": "13.2.0",
    "pdfjs-dist": "6.3.289",
    "photoswipe": "5.4.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router": "8.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "image-size": "2.0.2",
    "read-gedcom": "0.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
